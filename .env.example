# Copy this file to .env and fill in at least one key (both are free).
# With NO keys the agent still works: it searches + retrieves and prints
# the evidence, and embeddings fall back to local TF-IDF.

# Groq — fast free LLM inference (openai/gpt-oss-120b by default).
# Get a free key at: https://console.groq.com  (sign up -> API Keys)
GROQ_API_KEY=

# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-120b
# Note (v4): on retryable errors (429/5xx) generation automatically
# falls back through the other allowlisted Groq models
# (gpt-oss-120b -> gpt-oss-20b -> qwen3.8-27b) before failing.

# HuggingFace — free embeddings (all-MiniLM-L6-v2) and a fallback chat
# model. Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ---- Optional: autonomous browser agent (browse mode) -----------------
# Install the library first:
#   pip install 'browser-use==1.0.8'
# Then set GROQ_API_KEY (or HF_TOKEN) above. Chromium is downloaded on
# first use. Browse mode does NOT work on pure serverless (Vercel).
# BROWSER_USE_API_KEY=   # only needed if you use Browser Use Cloud
