# Copy this file to .env and fill in at least one key (both are free).
# With NO keys the agent still works: it searches + retrieves and prints
# the evidence, and embeddings fall back to local TF-IDF.

# Groq — fast free LLM inference (llama-3.3-70b-versatile).
# Get a free key at: https://console.groq.com  (sign up -> API Keys)
GROQ_API_KEY=

# HuggingFace — free embeddings (all-MiniLM-L6-v2) and a fallback chat
# model. Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=
